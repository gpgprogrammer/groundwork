# Merit runs with zero configuration locally (accounts in .data/state.json).
# Fill these in for production.

# Public URL of the app (used for auth redirects and metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Signs local-store session cookies. Required for ALLOW_DEMO_MODE on Vercel; use a long random value.
AUTH_SECRET=

# Hosted preview without Supabase (accounts reset when the server restarts). Never for real users.
# ALLOW_DEMO_MODE=true

# ── Supabase (auth + Postgres). Setting URL + anon key switches the local store off.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only.
SUPABASE_SERVICE_ROLE_KEY=

# ── YouTube Data API, only for `npm run ingest` (the keyless ingest needs nothing).
YOUTUBE_API_KEY=

# ── Tutoring partner referral codes. Once a partner agreement is signed, set the
# code they give you and every /r/<service> link carries it. Name = PARTNER_REF_<SERVICE_ID>.
# PARTNER_REF_WYZANT=
# PARTNER_REF_VARSITY_TUTORS=
# PARTNER_REF_PRINCETON_REVIEW=
# PARTNER_REF_TUTOR_COM=
# PARTNER_REF_PREPSCHOLAR=

# ── Payments (Stripe). Blank = labeled test mode, no charges.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Merit Plus free period for new accounts, in days (default 365)
# NEXT_PUBLIC_PLUS_TRIAL_DAYS=365

# ── Merit AI (Vercel AI Gateway). On Vercel, the OIDC token is used automatically.
# AI_GATEWAY_API_KEY=
# MERIT_AI_MODEL=anthropic/claude-sonnet-5
# MERIT_AI_CONTENT_MODEL=anthropic/claude-sonnet-5

# ── Admin dashboard access (comma-separated emails)
ADMIN_EMAILS=

# ── Contact email shown in Terms and Privacy
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Sign-in providers shown when Supabase is on (enable them in Supabase Auth too)
# NEXT_PUBLIC_OAUTH_PROVIDERS=google,apple
