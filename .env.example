# Groundwork runs with zero configuration in demo mode (local JSON store,
# seeded accounts, simulated checkout). Fill these in to go to production.

# Public URL of the app (used for auth redirects and metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Signs demo-mode session cookies. Set a long random value anywhere public.
AUTH_SECRET=

# ── Supabase (auth + Postgres). Setting URL + anon key switches demo mode off.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for Stripe webhooks, creator sign-up, and billing writes.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ($10/month, first month free). Leave blank for simulated checkout.
STRIPE_SECRET_KEY=
# Create with: STRIPE_SECRET_KEY=sk_test_... npm run stripe:setup
STRIPE_PRICE_ID=
# From `stripe listen --forward-to localhost:3000/api/billing/webhook` or the dashboard
STRIPE_WEBHOOK_SECRET=
